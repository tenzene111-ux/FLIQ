# Copy this file to .env and fill in real values for your environment.

# Postgres connection string. Uses a separate database from the Next.js
# app's "fliq" DB — keep the two apps' data isolated.
DATABASE_URL="postgresql://user:password@localhost:5432/fliq_backend"

# Sign access/refresh tokens. Generate your own with `openssl rand -hex 32`
# for each — never share these values or reuse one for both.
JWT_ACCESS_SECRET="change-me-to-a-long-random-string"
JWT_REFRESH_SECRET="change-me-to-a-different-long-random-string"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

PORT=4000
NODE_ENV=development

# Comma-separated list of allowed origins for the Flutter app / admin panel.
CORS_ORIGINS="http://localhost:3000"

# Object storage — S3-compatible, so the same code works with either
# provider. Pick one:
#
# Cloudflare R2 (dashboard.cloudflare.com -> R2 -> create bucket -> Manage
# API tokens for the access key/secret):
#   STORAGE_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
#   STORAGE_REGION="auto"
#   STORAGE_PUBLIC_URL="https://<your-r2-public-bucket-or-custom-domain>"
#   STORAGE_FORCE_PATH_STYLE="true"
#
# AWS S3 (console.aws.amazon.com/s3 -> create bucket; IAM -> create an
# access key scoped to that bucket):
#   STORAGE_ENDPOINT=""   (leave empty — the SDK resolves the S3 endpoint from the region)
#   STORAGE_REGION="us-east-1"
#   STORAGE_PUBLIC_URL="https://<bucket>.s3.<region>.amazonaws.com"
#   STORAGE_FORCE_PATH_STYLE="false"
STORAGE_ENDPOINT=""
STORAGE_REGION="us-east-1"
STORAGE_BUCKET="fliq-media"
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_FORCE_PATH_STYLE="false"
STORAGE_PUBLIC_URL=""

# Redis — used for rate limiting and feed caching, and by BullMQ for the
# job queue in a later step. A managed instance (Upstash, Redis Cloud,
# AWS ElastiCache) works the same as local Redis here.
REDIS_URL="redis://127.0.0.1:6379"
