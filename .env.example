# Copy this file to .env and fill in real values for your environment.

# Postgres connection string. Locally: run your own Postgres (or use a free
# hosted one like Neon/Supabase). In production on Vercel: add the "Postgres"
# storage integration in the Vercel dashboard and it fills this in for you.
DATABASE_URL="postgresql://user:password@localhost:5432/fliq"

# Any long random string — used to sign session cookies. Generate one with:
# `openssl rand -hex 32`
JWT_SECRET="change-me-to-a-long-random-string"

NEXT_PUBLIC_APP_NAME="Fliq"

# Storage provider for uploaded avatars/videos (see src/lib/storage.ts):
# - "local": writes to /public/uploads. Local dev only.
# - "vercel-blob": production. Add the Blob storage integration in the
#   Vercel dashboard (Storage → Create → Blob) — it injects
#   BLOB_READ_WRITE_TOKEN automatically, no manual token needed.
STORAGE_PROVIDER="local"
BLOB_READ_WRITE_TOKEN=""

# Google sign-in (optional — buttons show a friendly error if unset).
# From Google Cloud Console → APIs & Services → Credentials → OAuth client ID.
# Authorized redirect URI: <your-app-url>/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Apple sign-in (optional — requires a paid Apple Developer Program
# membership). From developer.apple.com → Certificates, IDs & Profiles.
# Redirect URI registered on your Services ID: <your-app-url>/api/auth/apple/callback
APPLE_CLIENT_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""
